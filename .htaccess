RewriteEngine On
RewriteCond %{HTTP} off
RewriteRule (.*) http://%{HTTP_HOST}%{REQUEST_URI} [R,L]

# mod_rewrite starts here

RewriteEngine on

# does not apply to existing directories, meaning that if the folder exists on the server then don' change anything and don't run the Rule!

RewriteCond %{REQUEST_FILENAME} !-d

#Check for file in directory with .php extension

RewriteCond %{REQUEST_FILENAME}\.php -f

# Here we actually show the page that has the .php extension

RewriteRule ^(.*)$ $1.php [NC,L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php80” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit